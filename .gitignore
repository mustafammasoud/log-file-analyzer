# Log File Analyzer - .gitignore

# -----------------------------------------------------------
# Python generated files
# -----------------------------------------------------------

# Byte-compiled / cached files
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/

# Virtual environment
venv/
.venv/
env/
.env/

# -----------------------------------------------------------
# Project generated outputs
# -----------------------------------------------------------

# CSV export files generated by --export flag
*.csv

# Log files generated during testing / custom runs
*.log

# -----------------------------------------------------------
# OS files
# -----------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.swp
.swo
.session

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------
# Editor / IDE files
# -----------------------------------------------------------

# VS Code
.vscode/
*.code-workspace

# Vim
*.swp
*.swo

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/
*.iml
*.iws
